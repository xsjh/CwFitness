# Development database.
#
# The dev database is a常驻 PostgreSQL service (a Windows service, Docker, or a remote
# server). It starts with the machine, so there is nothing to launch before `npm run dev`;
# `npm run db:dev` only checks that the connection works and applies any missing migration.
#
# On this machine: PostgreSQL 18, installed to D:\Program Files\PostgreSQL\18, listening on
# 5432. Two databases are provisioned on it:
#   cwfitness       — development, what DATABASE_URL below points at
#   cwfitness_test  — integration suite, created and migrated by `npm run test:integration`
#
# Setup from scratch:
#   1. install PostgreSQL and make sure its service is running
#   2. createdb cwfitness      (or: psql -U postgres -c "create database cwfitness")
#   3. npm run db:dev          (applies every migration, then reports "ready")
DATABASE_URL="postgres://postgres:0131@127.0.0.1:5432/cwfitness?sslmode=disable"

# The integration suite's database. Optional: `scripts/test-env.mjs` defaults to
# `cwfitness_test` on localhost with the credentials above. Set this when the suite should run
# against a different server, e.g. in CI.
#   CWFITNESS_TEST_DATABASE_URL="postgres://user:pass@host:5432/cwfitness_test?sslmode=disable"

BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://127.0.0.1:3100"
LOCAL_EMAIL_OUTBOX=".local-mail/outbox.jsonl"
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS="3600"
PASSWORD_RESET_EXPIRES_IN_SECONDS="3600"
