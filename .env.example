# Development database.
#
# Two shapes work here:
#
#   1. A `prisma dev` instance (what this project uses). Point the URL at the instance's
#      main port and run `npm run db:dev` to start it when it is not up. Instances are
#      not services — they die with the terminal that started them — which is why that
#      command exists and why `npm run dev` runs it first.
#        DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51218/template1?sslmode=disable"
#
#   2. A常驻 PostgreSQL (Windows service, Docker, a remote server). Any reachable URL
#      works and no dev-instance bookkeeping is involved; `npm run db:dev` just checks
#      the connection and applies migrations.
#        DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/cwfitness"
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51218/template1?sslmode=disable"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://127.0.0.1:3100"
LOCAL_EMAIL_OUTBOX=".local-mail/outbox.jsonl"
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS="3600"
PASSWORD_RESET_EXPIRES_IN_SECONDS="3600"
