generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  timeZone        String           @default("UTC")
  weightUnit      String           @default("kg")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  workoutPlans    WorkoutPlan[]
  exercises       Exercise[]
  workoutSessions WorkoutSession[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model WorkoutPlan {
  id              String           @id @default(cuid())
  name            String
  userId          String
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDays     WorkoutDay[]
  workoutSessions WorkoutSession[]

  @@index([userId])
  @@map("workout_plan")
}

enum ResistanceType {
  WEIGHTED
  BODYWEIGHT
}

enum TargetType {
  REPETITIONS
  DURATION
}

model Exercise {
  id               String            @id @default(cuid())
  name             String
  resistanceType   ResistanceType
  targetType       TargetType
  userId           String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedExercises PlannedExercise[]
  sessionExercises SessionExercise[]

  @@index([userId])
  @@map("exercise")
}

model WorkoutDay {
  id               String            @id @default(cuid())
  name             String
  suggestedWeekday Int?
  workoutPlanId    String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workoutPlan      WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  plannedExercises PlannedExercise[]
  workoutSessions  WorkoutSession[]

  @@index([workoutPlanId])
  @@map("workout_day")
}

model PlannedExercise {
  id           String     @id @default(cuid())
  workoutDayId String
  exerciseId   String
  setCount     Int
  targetValue  Int
  weightGrams  Int?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionExercises SessionExercise[]

  @@unique([workoutDayId, exerciseId])
  @@index([exerciseId])
  @@map("planned_exercise")
}

enum SessionExerciseSource {
  PLANNED
  ADDED
}

enum WorkoutSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

model WorkoutSession {
  id                  String               @id @default(cuid())
  userId              String
  workoutPlanId       String
  workoutDayId        String?
  workoutPlanName     String
  workoutDayName      String
  timeZone            String
  localStartDate      String
  status              WorkoutSessionStatus @default(ACTIVE)
  startedAt           DateTime             @default(now())
  pausedAt            DateTime?
  pausedDurationMs    Int                  @default(0)
  activeDurationMs    Int                  @default(0)
  completedAt         DateTime?
  modifiedAt          DateTime?
  trainingTimeSeconds Int?
  lastHeartbeatAt     DateTime?
  version             Int                  @default(1)
  editingDeviceId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan         WorkoutPlan          @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)
  workoutDay          WorkoutDay?          @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  exercises           SessionExercise[]

  @@index([userId, status])
  @@index([workoutPlanId])
  @@map("workout_session")
}

model SessionExercise {
  id               String                @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  exerciseName     String
  resistanceType   ResistanceType
  targetType       TargetType
  setCount         Int
  targetValue      Int
  weightGrams      Int?
  position         Int                   @default(0)
  source           SessionExerciseSource @default(PLANNED)
  plannedExerciseId String?
  removedAt        DateTime?
  createdAt        DateTime              @default(now())
  workoutSession   WorkoutSession        @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise         Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  plannedExercise  PlannedExercise?      @relation(fields: [plannedExerciseId], references: [id], onDelete: SetNull)
  setResults       SessionSetResult[]

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@index([plannedExerciseId])
  @@map("session_exercise")
}

model SessionSetResult {
  id                String          @id @default(cuid())
  sessionExerciseId String
  setIndex          Int
  actualValue       Int?
  actualWeightGrams Int?
  skipped           Boolean         @default(false)
  operationId       String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setIndex])
  @@map("session_set_result")
}
